<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>highways</AssemblyName>
    <RootNamespace>Highway.Server.Host</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- Globalization-invariant: the broker parses/compares with InvariantCulture throughout
         (RESP, ASCII identifiers, invariant number/size/cron parsing), so it needs no ICU. This
         makes the self-contained Linux build a true zero-dependency drop — no `apt install libicu`
         on the target, where .NET would otherwise FailFast on first culture use. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Highway.Server.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Highway.Server\Highway.Server.csproj" />
    <!-- The dashboard ships inside the packaged broker; its FrameworkReference on
         Microsoft.AspNetCore.App flows transitively (feature 031 D1). -->
    <ProjectReference Include="..\Highway.Server.Dashboard\Highway.Server.Dashboard.csproj" />
    <!-- Feature 036: service verbs and hosting extracted into a shared package.
         The broker executable consumes the shared SCM code instead of its private copy. -->
    <ProjectReference Include="..\Highway.Client.Hosting\Highway.Client.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- Feature 045: rolling file logs into the distribution's logs/ folder, so a broker
         installed as a Windows service (no console, stdout discarded) has readable logs. -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
