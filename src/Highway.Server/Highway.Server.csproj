<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Highway.Server</RootNamespace>
    <!-- Required for the vendored Resp/Vendored/RespWriteUtils.cs, which writes RESP frames
         through byte* (the one Garnet-derived source; see THIRD-PARTY-NOTICES.md). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Highway.LocalServer</PackageId>
    <Description>In-process Highway broker for integration tests and local development. Start a real broker inside your test host with HighwayTestServer — no Docker, no external infrastructure. Production deployments use the standalone highways distribution from GitHub Releases, not this package.</Description>
    <PackageTags>highway;testserver;integration-testing;in-memory;local-development;broker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Highway.Server.Tests" />
    <InternalsVisibleTo Include="Highway.Integration.Tests" />
    <InternalsVisibleTo Include="Highway.Server.Dashboard" />
    <InternalsVisibleTo Include="Highway.Storage.CrashHarness" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Highway.Abstractions\Highway.Abstractions.csproj" />
  </ItemGroup>

  <!-- Feature 040: Kestrel is the socket (037 D3). The ASP.NET Core shared framework carries
       Kestrel + the connection abstractions; referenced as a framework, not a pinned package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- SE.Redis: the server connects to itself at startup for the pre-018 data check, and the
         type is the client transport the suite drives the broker with. -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Feature 037/038: the RocksDB storage engine behind IHighwayStore. -->
    <PackageReference Include="RocksDB" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
