<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Highway.Client</RootNamespace>
    <PackageId>Highway.Client</PackageId>
    <Description>High-performance .NET client for Highway distributed messaging broker. Provides durable queues, pub/sub, RPC, lease renewer, distributed caching, rate limiter, and recurring jobs.</Description>
    <PackageTags>highway;messaging;microservices;queues;pubsub;rpc;garnet;cache;distributed-systems</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Highway.Client.Tests" />
    <InternalsVisibleTo Include="Highway.Integration.Tests" />
    <InternalsVisibleTo Include="Highway.Assurance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Highway.Abstractions\Highway.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
