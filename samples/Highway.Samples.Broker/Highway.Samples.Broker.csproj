<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Highway.Samples.Broker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Highway.Server\Highway.Server.csproj" />
    <!-- Opt-in: the dashboard is a separate package, so a broker that does not
         reference it contains no web-host dependency at all (feature 011). -->
    <ProjectReference Include="..\..\src\Highway.Server.Dashboard\Highway.Server.Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SampleConfig.cs" Link="SampleConfig.cs" />
  </ItemGroup>

</Project>
