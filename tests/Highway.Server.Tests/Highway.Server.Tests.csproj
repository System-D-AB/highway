<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Highway.Server\Highway.Server.csproj" />
    <!-- Built alongside the tests so the T6 crash-replay test can spawn it as a child
         process. ReferenceOutputAssembly=false: we invoke it via `dotnet exec`, not link it. -->
